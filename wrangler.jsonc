{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stem-keys",
  "account_id": "dcc351bf73bdc32b74df7483129f41eb",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "services": [
    { "binding": "YOUTUBE_IMPORTER", "service": "stem-keys-importer" },
  ],
  "ratelimits": [
    {
      "name": "IMPORT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
}
