{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stem-keys-importer",
  "account_id": "ed9fc60a070609574054b8f12be7460a",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "YoutubeImporter",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "IMPORTER", "class_name": "YoutubeImporter" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["YoutubeImporter"] }],
  "observability": { "enabled": true },
}
